# Copy to .env for local development: cp .env.example .env

# Long random string. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Database.
#   empty or file:...  -> SQLite, for local development (default: file:./data/payload.db)
#   postgres://...     -> Postgres. Neon in production and Vercel preview deployments.
DATABASE_URL=

# Vercel Blob read/write token. Leave empty locally: uploads are stored in ./image instead.
BLOB_READ_WRITE_TOKEN=
