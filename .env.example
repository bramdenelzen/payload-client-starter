# Copy to .env for local development: cp .env.example .env

# Long random string. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Database.
#   empty or file:...  -> SQLite, for local development (default: file:./data/payload.db)
#   postgres://...     -> Postgres. Neon in production and Vercel preview deployments.
DATABASE_URL=

# Vercel Blob read/write token. Leave empty locally: uploads are stored in ./image instead.
BLOB_READ_WRITE_TOKEN=

# Optional: AI suggestions for SEO titles, descriptions and alt text (Anthropic API key).
# Without it the buttons give rule-based text and the alt text button is hidden.
ANTHROPIC_API_KEY=

# Public URL of the site, e.g. https://www.client.nl. Used for canonical URLs and the sitemap.
# Not needed on Vercel (it uses the production domain); required on Docker/Render.
NEXT_PUBLIC_SERVER_URL=
